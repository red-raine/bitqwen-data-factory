# BitQwen 1.0 Background Data Factory — credentials template
# Copy to .env and fill in your own keys. All providers below have FREE tiers.
# NEVER commit real keys to version control. This file contains PLACEHOLDERS only.

# ---------------------------------------------------------------------------
# PRIMARY generator — Google AI Studio (Gemini 2.0 Flash, free tier)
# Get a key: https://aistudio.google.com/app/apikey
# Free tier: ~1,500 requests/day, 15 RPM, 2M tokens/min
# This is a SEPARATE provider from the legacy Gemini key below — set it to a
# distinct free-tier key to get its own 1500/day quota.
GOOGLE_AI_STUDIO_KEY=your_google_ai_studio_key_here

# Alias / fallback for GoogleAIStudioProvider if GOOGLE_AI_STUDIO_KEY is unset.
# Also used by the legacy GeminiProvider (which targets gemini-2.5-flash).
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# SECONDARY generator — HuggingFace Inference API (rotate across 5+ models)
# Get a token: https://huggingface.co/settings/tokens
# Free tier: per-model rate limit (~500/model/day); rate limiter caps at 500/day
HF_TOKEN=your_hf_token_here

# ---------------------------------------------------------------------------
# TERTIARY generator — OpenRouter free models (14 free models)
# Get a key: https://openrouter.ai/keys
# Free tier: ~100 req/day (conservative cap to avoid "add money" errors)
OPENROUTER_API_KEY=your_openrouter_api_key_here
